import boto3
from datetime import datetime


dynamodb = boto3.resource(
    "dynamodb",
    region_name="eu-north-1"
)


table = dynamodb.Table("log_history")


def store_log(log_id,log_data, ai_summary):

    response = table.put_item(
        Item={
            "log_id": log_id,

            "timestamp":
            datetime.now().isoformat(),

            "server":
            "EC2-Web-Server",

            "error_type":
            log_data.get("level"),

            "message":
            log_data.get("message"),

            "ai_summary":
            ai_summary,

            "severity":
            "HIGH"
        }
    )

    return response

def get_all_logs():
    response = table.scan()
    return response.get("Items", [])


def get_log_by_id(log_id):

    response = table.get_item(
        Key={
            "log_id": log_id
        }
    )

    return response.get("Item")


def get_high_severity_logs():

    response = table.scan()

    logs = response.get("Items", [])

    return [
        log for log in logs
        if log.get("severity") == "HIGH"
    ]
